{
  "name": "@class-task-tracker/backend",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "bun dist/index.js",
    "db:init": "bun src/db/init-db.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun src/db/seeds/dev.seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@class-task-tracker/shared": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.7.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6"
  }
}
