{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "moduleResolution": "node",
    "baseUrl": "./src",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "*"
      ],
      "@shared": [
        "../shared/index.ts"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@class-task-tracker/shared": [
        "../shared/index.ts"
      ],
      "@class-task-tracker/shared/*": [
        "../shared/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}