{
  "name": "class-task-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "bun run --cwd backend dev & bun run --cwd frontend dev",
    "build": "bun run --cwd backend build && bun run --cwd frontend build",
    "db:init": "bun run --cwd backend db:init",
    "db:push": "bun run --cwd backend db:push",
    "db:generate": "bun run --cwd backend db:generate",
    "db:migrate": "bun run --cwd backend db:migrate",
    "db:seed": "bun run --cwd backend db:seed",
    "db:studio": "bun run --cwd backend db:studio",
    "test": "bun run --cwd backend test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}